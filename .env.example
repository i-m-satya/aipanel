APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=                       # 32-byte base64, generated by: php bin/console.php key:generate

DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=aipanel;charset=utf8mb4
DB_USER=aipanel
DB_PASS=secret

REDIS_DSN=tcp://127.0.0.1:6379

# Control plane -> node agent
AGENT_TIMEOUT=60
AGENT_CLOCK_SKEW=30

# Worker
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=5
WORKER_SLEEP_MS=500
NODE_MAX_CONCURRENCY=4

# Assistant
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ASSISTANT_ENABLED=true

# --- GitHub ------------------------------------------------------------------
# Login is GitHub-only; these are required for anyone to sign in.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# The GitHub App aipanel uses to read repos, register deploy keys and open PRs.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/etc/aipanel/github-app.pem
AIPANEL_PORT=2087
